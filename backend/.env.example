PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h
CLIENT_URL=http://localhost:5173

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only, port 6543)
# Used by the running application
DATABASE_URL=your_supabase_transaction_pooler_url

# Connect to Postgres via the shared session-mode pooler (port 5432)
# Reserved for migrations and schema management
DIRECT_URL=your_supabase_session_pooler_url

# Cloudinary Storage Configuration (Optional for cloud document/avatar storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=cloudinary://your_key:your_secret@your_cloud_name
