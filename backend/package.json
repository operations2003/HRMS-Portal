{
  "name": "hrms-backend",
  "version": "1.0.0",
  "description": "HRMS Portal Backend API Server",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
